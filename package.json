{
  "name": "bcc-email-stats",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "cf-types": "wrangler types",
    "check": "tsc --noEmit",
    "validate": "npm run cf-types && npm run check && npm run d1:migrate:local && wrangler deploy --dry-run",
    "hooks:install": "git config core.hooksPath .githooks",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create bcc-email-stats",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local",
    "d1:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "wrangler": "^4.151.1"
  }
}
